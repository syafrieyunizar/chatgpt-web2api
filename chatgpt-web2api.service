[Unit]
Description=ChatGPT Web to OpenAI API proxy
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/chatgpt-web2api
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python3 /home/ubuntu/chatgpt-web2api/chatgpt_web2api.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target